{
  "name": "@rljson/uikit",
  "version": "0.0.3",
  "description": "rljson UI kit — reusable browser UI components",
  "homepage": "https://github.com/rljson/uikit",
  "bugs": "https://github.com/rljson/uikit/issues",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.14.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rljson/uikit.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc",
    "prebuild": "pnpm run test",
    "build": "vite build && tsc -p tsconfig.build.json",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build -o storybook-static",
    "prepublishOnly": "pnpm run build",
    "test": "pnpm test:unit && pnpm test:e2e && pnpm test:snapshots",
    "test:unit": "pnpm run typecheck && vitest run --coverage && pnpm run lint",
    "test:e2e": "playwright test",
    "test:snapshots": "playwright test --update-snapshots",
    "lint": "prettier --write . && eslint --fix"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@storybook/html-vite": "^10.5.5",
    "@types/node": "^26.0.1",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.6.0",
    "eslint-plugin-jsdoc": "^63.0.10",
    "eslint-plugin-tsdoc": "^0.5.2",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.4",
    "storybook": "^10.5.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.1.2",
    "vitest": "^4.1.9",
    "vitest-dom": "^0.1.1"
  },
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72"
}
